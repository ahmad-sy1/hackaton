# Kopieer dit bestand naar .env.
# De standaardwaarde hieronder werkt direct met de meegeleverde docker-compose.yml.
DATABASE_URL=postgres://dekast:dekast@localhost:5432/dekast

# Aparte testdatabase voor Cypress, in dezelfde Postgres-container (dekast-db).
# Zorg dat de database "dekast_test" bestaat en gemigreerd is voor je test draait.
DATABASE_URL_TEST=postgres://dekast:dekast@localhost:5432/dekast_test
