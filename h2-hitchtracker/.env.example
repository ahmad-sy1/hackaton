# Kopieer dit bestand naar .env.
# De standaardwaarde hieronder werkt direct met de meegeleverde docker-compose.yml.
DATABASE_URL=postgres://hitchtracker:hitchtracker@localhost:5433/hitchtracker

# Aparte database voor de integratietest (npm run test:integration). Wordt bij elke test geleegd,
# dus nooit naar de ontwikkeldatabase laten wijzen.
DATABASE_URL_TEST=postgres://hitchtracker:hitchtracker@localhost:5433/hitchtracker_test
